# Backend port
PORT=8787
# Comma separated list of allowed frontend origins.
# Leave empty in local development to allow any origin.
ALLOWED_ORIGINS=http://localhost:5173
# MongoDB connection string. Keep credentials in backend/.env, never commit them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Database name created/used in the cluster.
MONGODB_DB=yuzersef
# Required to access /api/admin routes. Use a long random value.
ADMIN_API_KEY=replace-with-a-long-random-secret
